# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgres://username:password@host:5432/database"

# ============================================
# APPLICATION URLs
# ============================================
BETTER_AUTH_URL='http://localhost:3000'
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fallbacks used by lib/utils/domain.ts
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Next.js Starter Kit"
# Base URL used by the Better Auth client (lib/auth-client.ts)
NEXT_BETTER_APP_URL=http://localhost:3000

# --------------------------------------------
# PRODUCTION (live at https://nextjs-starter-kit-gules.vercel.app — first deploy 2026-08-25)
# Uncomment/override these in Vercel Project Settings → Environment Variables.
# Localhost defaults above are for development only; do not change them here.
# --------------------------------------------
# BETTER_AUTH_URL=https://nextjs-starter-kit-gules.vercel.app
# NEXT_PUBLIC_API_URL=https://nextjs-starter-kit-gules.vercel.app
# NEXT_PUBLIC_APP_URL=https://nextjs-starter-kit-gules.vercel.app
# NEXT_PUBLIC_SITE_URL=https://nextjs-starter-kit-gules.vercel.app
# NEXT_PUBLIC_BASE_URL=https://nextjs-starter-kit-gules.vercel.app
# NEXT_BETTER_APP_URL=https://nextjs-starter-kit-gules.vercel.app

# ============================================
# BETTER AUTH
# ============================================
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_API_KEY="your-api-key-here"

# ============================================
# EMAIL PROVIDERS (choose one via EMAIL_PROVIDER)
# ============================================
# Chosen production provider: Resend (see docs/DEPLOYMENT.md)
EMAIL_PROVIDER="resend"

# Resend (PRIMARY — requires RESEND_API_KEY + verified domain)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL=onboarding@yourdomain.com
RESEND_FROM_NAME="Next.js Starter Kit"

# Nodemailer (SMTP — alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="Next.js Starter Kit"
SMTP_FROM_EMAIL=noreply@starterkit.dev
# Legacy mail transport (features/mail/lib/index.ts) reads these instead:
SMTP_PASS=your-app-password
SMTP_FROM=noreply@starterkit.dev

# ============================================
# UPLOAD PROVIDERS (choose one via UPLOAD_PROVIDER)
# ============================================
# Chosen production provider: S3 (see docs/DEPLOYMENT.md)
UPLOAD_PROVIDER="s3"

# AWS S3 (PRIMARY — requires IAM access keys + public bucket/domain)
S3_ENDPOINT=https://s3.region.amazonaws.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="your-bucket-name"
S3_PUBLIC_DOMAIN=https://your-bucket.s3.region.amazonaws.com

# Cloudflare R2 (S3-compatible — alternative)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_DOMAIN=https://your-domain.com
R2_REGION=auto

# Cloudinary (alternative)
# Server-side SDK reads CLOUDINARY_CLOUD_NAME; client uses NEXT_PUBLIC_
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Local storage (development only — Vercel filesystem is ephemeral)
UPLOAD_DIR="./public/uploads"

# ============================================
# CRON JOBS (optional)
# ============================================
ENABLE_CRON_SECRET_CHECK=false
CRON_SECRET="your-cron-secret"
# Days before soft-deleted records are purged (cron/cleanup.ts)
CLEANUP_SOFT_DELETE_DAYS=30

# ============================================
# TESTING (optional)
# ============================================
# TEST_SEND_TO_MAIL=your-test-email@example.com
# TEST_CRON_INTERVAL_MINUTES=5
