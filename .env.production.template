# ============================================================
# PRODUCTION ENVIRONMENT TEMPLATE — nextjs-starter-kit
# Fill in real values, then paste into:
#   Vercel Project Settings → Environment Variables → Production
# PLACEHOLDERS ONLY — never commit real secrets.
# Mirror of docs/ENV-VARS.md
# ============================================================

# --- REQUIRED (fixes /login server error) ---
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"
BETTER_AUTH_SECRET="PASTE_openssl_rand_base64_32_OUTPUT"
BETTER_AUTH_URL="https://nextjs-starter-kit-gules.vercel.app"
NEXT_BETTER_APP_URL="https://nextjs-starter-kit-gules.vercel.app"
NEXT_PUBLIC_SITE_URL="https://nextjs-starter-kit-gules.vercel.app"

# --- Provider selection ---
EMAIL_PROVIDER="resend"
UPLOAD_PROVIDER="s3"

# --- Email (Resend) ---
RESEND_API_KEY="re_REPLACE_WITH_REAL_KEY"
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Next.js Starter Kit"

# --- Upload (AWS S3) ---
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="REPLACE_WITH_AWS_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="REPLACE_WITH_AWS_SECRET_ACCESS_KEY"
S3_BUCKET_NAME="your-bucket-name"
S3_PUBLIC_DOMAIN="https://your-bucket.s3.us-east-1.amazonaws.com"

# --- Optional URL aliases (recommended) ---
NEXT_PUBLIC_APP_URL="https://nextjs-starter-kit-gules.vercel.app"
NEXT_PUBLIC_API_URL="https://nextjs-starter-kit-gules.vercel.app"
NEXT_PUBLIC_BASE_URL="https://nextjs-starter-kit-gules.vercel.app"

# --- Optional misc ---
NEXT_PUBLIC_APP_NAME="Next.js Starter Kit"
